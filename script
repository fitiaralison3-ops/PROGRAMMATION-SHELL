#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
    echo "Ce script doit être exécuté en root." >&2
    exit 1
fi

set -o pipefail

########################################################################
#                      VARIABLES GLOBALES
########################################################################

cle="$HOME/.ssh/id_contrall.pub"
key="$HOME/.ssh/id_contrall"

LOG="/var/log/contrall.log"
SESSION_LOG="/var/log/contrall_sessions.log"
ERROR_LOG="/var/log/contrall_errors.log"
rapport="/var/log/contrall_rapport_$(date '+%Y%m%d_%H%M%S').txt"

LISTE="/etc/contrAll/user.txt"
FICHIER_ALERTES="/etc/contrAll/alertes_actives.txt"
RESTRICTION_FILE="/etc/contrAll/restriction.txt"

BLACKLIST_LOCALE="/etc/contrAll/blacklist.txt"
CMD_BLACKLIST_LOCALE="/etc/contrAll/cmd_blacklist.txt"
TERMINAL_AUTORISE_LOCALE="/etc/contrAll/terminal_autorise.txt"

MAX=50
x=0

suspendus="/etc/contrAll/suspendus.txt"
COOLDOWN_FILE="/etc/contrAll/contrall_cooldown.txt"

seuil=3
duree=10
temps=5

opt="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
     -o ServerAliveInterval=30 -o ControlMaster=auto \
     -o ControlPath=/tmp/ssh_contrall_%h_%p_%r \
     -o ControlPersist=60"
readonly opt

trap nettoyage EXIT INT TERM

noir='\033[0;30m'
rouge='\033[0;31m'
vert='\033[0;32m'
jaune='\033[0;33m'
bleu='\033[1;34m'
violet='\033[0;35m'
cyan='\033[0;36m'
blanc='\033[0;37m'
neutre='\033[0m'
gras='\033[1m'
norm='\033[0m'

numerique() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

# Validation des noms d'utilisateur
utilisateur_valide() {
    [[ "$1" =~ ^[a-zA-Z0-9_.-]+$ ]]
}

# Échappement pour les expressions régulières (sed/grep)
echapper_regex() {
    printf '%s' "$1" | sed 's/[][\.^$*/&]/\\&/g'
}

########################################################################
#                        FONCTIONS
########################################################################

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$1]: $2" >> "$LOG"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$1]: $2" >> "$ERROR_LOG"
}

log_session_debut() {
    date_debut=$(date '+%Y-%m-%d %H:%M:%S')
    echo "========================================" >> "$SESSION_LOG"
    echo "SESSION $date_debut" >> "$SESSION_LOG"
    echo "Master: $(whoami)" >> "$SESSION_LOG"
    echo "Durée: $temps minutes" >> "$SESSION_LOG"
    echo "Seuil: $seuil infractions" >> "$SESSION_LOG"
    echo "Suspension: $duree minutes" >> "$SESSION_LOG"
    echo "----------------------------------------" >> "$SESSION_LOG"
}

log_session_fin() {
    local date_fin=$(date '+%Y-%m-%d %H:%M:%S')
    echo "FIN SESSION $date_fin" >> "$SESSION_LOG"
    local nb_infractions=$(wc -l < "$FICHIER_ALERTES" 2>/dev/null || echo 0)
    local nb_suspendus=$(wc -l < "$suspendus" 2>/dev/null || echo 0)
    echo "Infractions totales: $nb_infractions" >> "$SESSION_LOG"
    echo "Utilisateurs suspendus: $nb_suspendus" >> "$SESSION_LOG"
    echo "========================================" >> "$SESSION_LOG"
    echo "" >> "$SESSION_LOG"
}

log_infraction_session() {
    local user="$1" ip="$2" type="$3" detail="$4"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] INFRACTION $user@$ip | $type: $detail" >> "$SESSION_LOG"
}

log_suspension_session() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] SUSPENSION $1@$2" >> "$SESSION_LOG"
}

log_levee_session() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] LEVEE $1@$2 ($3)" >> "$SESSION_LOG"
}

debloquer_urgence() {
    local user="$1" ip="$2"
    [ -z "$user" ] || [ -z "$ip" ] && { log_error "ERREUR" "Paramètres manquants"; return 1; }
    echo "Déblocage d'urgence pour $user@$ip ..."
    esc_user=$(echapper_regex "$user")
    local uid
    uid=$(ssh -i "$key" $opt "root@$ip" "id -u '$user'" 2>/dev/null)
    ssh -i "$key" $opt "root@$ip" "
        passwd -u '$user' 2>/dev/null
        usermod --expiredate '' '$user' 2>/dev/null
        sed -i '/^$esc_user$/d' /etc/cron.deny 2>/dev/null
        sed -i '/^$esc_user$/d' /etc/at.deny 2>/dev/null
        s=\$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u='$user' '\$3==u {print \$1; exit}')
        [ -n \"\$s\" ] && systemctl thaw \"session-\${s}.scope\" 2>/dev/null || true
        systemctl thaw user-\$(id -u '$user').slice 2>/dev/null || true
    " 2>/dev/null
    [ -n "$uid" ] && unblock_network "$ip" "$uid"
    echo "Déblocage terminé."
}

notifier_client() {
    local user="$1" ip="$2" titre="$3" message="$4"
    ssh -i "$key" $opt "root@$ip" "
        wall '[$titre] $message' 2>/dev/null || true
        uid=\$(id -u $user 2>/dev/null)
        [ -z \"\$uid\" ] && exit 0
        disp=\$(loginctl show-user \"$user\" -p Display --value 2>/dev/null)
        [ -z \"\$disp\" ] && disp=':0'
        bus=\"unix:path=/run/user/\$uid/bus\"
        sudo -u $user DISPLAY=\"\$disp\" DBUS_SESSION_BUS_ADDRESS=\"\$bus\" \
            notify-send -u critical '$titre' '$message' 2>/dev/null || true
    " 2>/dev/null
}

nettoyage() {
    clear
    echo -e "${jaune}Nettoyage en cours...${neutre}"
    [ -n "${tmpfile:-}" ] && rm -f "${tmpfile:-}" "${tmpfile:-}.lock" 2>/dev/null || true
    rm -f /tmp/tableau_propre 2>/dev/null || true
    kill "${verification_pid:-}" 2>/dev/null || true
    kill "${tableau_pid:-}" 2>/dev/null || true
    if [ -f "$LISTE" ]; then
        while IFS=":" read -r user ip; do
            [ -z "$user" ] && continue
            debloquer_urgence "$user" "$ip"
            nettoyer_alias "$user" "$ip"
        done < "$LISTE"
    fi
    echo -e "${vert}Nettoyage terminé.${neutre}"
}

dependance() {
    local deps=(bash dialog ssh scp sshpass nc flock awk sed hostname date host)
    local missing=()
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing+=("$dep")
        fi
    done
    if [ "${#missing[@]}" -ne 0 ]; then
        echo "Dépendances manquantes : ${missing[*]}" >&2
        exit 1
    fi
}

dependance
dialog --title "ContrAll" --msgbox "Système de supervision de réseau\n\nMaster:$(whoami)" 12 55

initialiser_fichiers() {
    [ ! -d "/etc/contrAll" ] && mkdir -p /etc/contrAll && chmod 700 /etc/contrAll
    [ ! -d "/var/log" ] && mkdir -p /var/log
    [ ! -f "$LISTE" ] && touch "$LISTE"
    [ ! -f "$FICHIER_ALERTES" ] && touch "$FICHIER_ALERTES"
    [ ! -f "$RESTRICTION_FILE" ] && touch "$RESTRICTION_FILE"
    [ ! -f "$COOLDOWN_FILE" ] && touch "$COOLDOWN_FILE"
    [ ! -f "$LOG" ] && touch "$LOG"
    [ ! -f "$SESSION_LOG" ] && touch "$SESSION_LOG"
    [ ! -f "$ERROR_LOG" ] && touch "$ERROR_LOG"
    chmod 600 "$RESTRICTION_FILE" "$COOLDOWN_FILE" "$FICHIER_ALERTES"
    log "INFO" "Initialisation des fichiers de surveillance"
}

nettoyer_surveillance() {
    > "$FICHIER_ALERTES"
    > "$RESTRICTION_FILE"
    > "$COOLDOWN_FILE"
    rm -f "$HOME/.apps_"* "$HOME/.last_cmd_"* "$HOME/.term_"*
    while IFS=":" read -r user ip; do
        ssh -i "$key" $opt "root@$ip" "rm -f /tmp/contrall_alertes_${user}.txt" 2>/dev/null
    done < "$LISTE"
    log "INFO" "Fichiers de surveillance nettoyés"
}

marquer_cooldown() {
    local user="$1" ip="$2"
    local expire_at=$(( $(date +%s) + (duree * 60) ))
    [ -f "$COOLDOWN_FILE" ] || touch "$COOLDOWN_FILE"
    (
        flock 200
        sed -i "/^$user:$ip:/d" "$COOLDOWN_FILE"
        echo "$user:$ip:$expire_at" >> "$COOLDOWN_FILE"
    ) 200>"$COOLDOWN_FILE.lock"
}

verifier_cooldown() {
    local user="$1" ip="$2" now=$(date +%s)
    [ -f "$COOLDOWN_FILE" ] || return 1
    local expire_at=$(awk -F: -v u="$user" -v i="$ip" '$1==u && $2==i {print $3}' "$COOLDOWN_FILE" | tail -n 1)
    [ -n "$expire_at" ] || return 1
    if [ "$expire_at" -gt "$now" ]; then
        return 0
    fi
    (
        flock 200
        sed -i "/^$user:$ip:/d" "$COOLDOWN_FILE"
    ) 200>"$COOLDOWN_FILE.lock"
    return 1
}

verifier_ssh() {
    local ip="$1" user="$2"
    ssh -i "$key" $opt "root@$ip" "true" 2>/dev/null
}

configuration() {
    > "$BLACKLIST_LOCALE"
    > "$CMD_BLACKLIST_LOCALE"
    > "$TERMINAL_AUTORISE_LOCALE"
    
    declare -A categorie
    categorie["navigation"]="firefox firefox-bin google-chrome chromium brave-browser vivaldi vivaldi-stable microsoft-edge opera torbrowser-launcher"
    categorie["messagerie"]="telegram-desktop discord signal-desktop caprine whatsapp-for-linux element-desktop slack"
    categorie["jeux"]="steam lutris heroic minecraft-launcher itch wine wineserver"
    categorie["multimedia"]="vlc mpv obs-studio audacity kdenlive spotify"
    categorie["telechargement"]="transmission-gtk qbittorrent deluge filezilla"
    categorie["bureautique"]="soffice soffice.bin libreoffice libreoffice-writer libreoffice-calc gimp inkscape"
    categorie["reseaux_sociaux"]="thunderbird thunderbird-bin evolution mail"

    declare -A commande
    commande["reseau"]="nmap nc netcat hydra wireshark tcpdump aircrack-ng"
    commande["telechargement"]="wget rsync curl scp"
    commande["contournement"]="systemctl kill pkill"
    commande["privileges"]="sudo su"

    temps=$(dialog --title "ContrAll — Configuration" --inputbox "Durée de surveillance en minutes:" 8 55 "10" 3>&1 1>&2 2>&3)
    [ $? -ne 0 ] || [ -z "$temps" ] || ! numerique "$temps" && temps=10
    log "INFO" "Durée de surveillance: $temps minutes"

    seuil=$(dialog --title "ContrAll — Configuration" --inputbox "Nombre de restrictions acceptées avant suspension:" 8 55 "3" 3>&1 1>&2 2>&3)
    [ $? -ne 0 ] || [ -z "$seuil" ] || ! numerique "$seuil" && seuil=3
    log "INFO" "Seuil: $seuil restriction(s)"

    duree=$(dialog --title "ContrAll — Configuration" --inputbox "Durée de la suspension en minutes:" 8 55 "1" 3>&1 1>&2 2>&3)
    [ $? -ne 0 ] || [ -z "$duree" ] || ! numerique "$duree" && duree=1
    log "INFO" "Durée d'une suspension: $duree minutes"

    categories=$(dialog --title "ContrAll — Logiciels interdits" --checklist "Sélectionnez les catégories à interdire :" 20 65 7 \
        "navigation" "firefox, chrome, chromium..." on \
        "messagerie" "discord, telegram, slack..." off \
        "jeux" "steam, lutris, wine..." off \
        "multimedia" "vlc, spotify, obs..." off \
        "telechargement" "qbittorrent, filezilla..." off \
        "bureautique" "gimp, inkscape..." off \
        "reseaux_sociaux" "thunderbird, evolution..." off 3>&1 1>&2 2>&3)
    if [ $? -ne 0 ] || [ -z "$categories" ]; then
        log "AVERTISSEMENT" "Aucune catégorie sélectionnée"
    else
        categories_propres=$(echo "$categories" | tr -d '"')
        for cat in $categories_propres; do
            [ -z "$cat" ] && continue
            [ -z "${categorie[$cat]:-}" ] && continue
            for app in ${categorie[$cat]}; do
                echo "$app" >> "$BLACKLIST_LOCALE"
            done
            log "INFO" "Catégorie interdite : $cat"
        done
    fi

    commandes=$(dialog --title "ContrAll — Commandes interdites" --checklist "Sélectionnez les catégories de commandes à interdire :" 16 65 4 \
        "privileges" "sudo, su" on \
        "reseau" "nmap, wireshark, tcpdump..." off \
        "contournement" "systemctl, kill, pkill" off \
        "telechargement" "wget, curl, scp" off 3>&1 1>&2 2>&3)
    if [ $? -ne 0 ] || [ -z "$commandes" ]; then
        log "AVERTISSEMENT" "Aucune commande sélectionnée"
    else
        commandes_propres=$(echo "$commandes" | tr -d '"')
        for com in $commandes_propres; do
            [ -z "$com" ] && continue
            [ -z "${commande[$com]:-}" ] && continue
            for cmd in ${commande[$com]}; do
                echo "$cmd" >> "$CMD_BLACKLIST_LOCALE"
            done
            log "INFO" "Commandes interdites : $com"
        done
    fi

    terminal=$(dialog --title "ContrAll — Terminal autorisé" --menu "Choisissez le terminal autorisé :" 18 60 6 \
        "gnome-terminal" "GNOME — Ubuntu par défaut" \
        "xterm" "Terminal basique" \
        "konsole" "KDE Plasma" \
        "xfce4-terminal" "XFCE" \
        "tilix" "Terminal avancé" \
        "terminator" "Terminal avec split" 3>&1 1>&2 2>&3)
    [ $? -ne 0 ] || [ -z "$terminal" ] && terminal="gnome-terminal"
    echo "$terminal" > "$TERMINAL_AUTORISE_LOCALE"
    log "INFO" "Terminal autorisé : $terminal"
}

block_network() {
    local ip="$1" uid="$2"
    ssh -i "$key" $opt "root@$ip" "
        if command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q .; then
            nft add rule inet filter output meta skuid $uid drop 2>/dev/null || \
            nft add rule ip filter output meta skuid $uid drop 2>/dev/null || \
            iptables -A OUTPUT -m owner --uid-owner $uid -j DROP 2>/dev/null || true
        else
            iptables -A OUTPUT -m owner --uid-owner $uid -j DROP 2>/dev/null || true
        fi
    " 2>/dev/null
}

unblock_network() {
    local ip="$1" uid="$2"
    ssh -i "$key" $opt "root@$ip" "
        if command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q .; then
            handle=\$(nft -a list chain inet filter output 2>/dev/null | grep \"skuid $uid drop\" | grep -oP 'handle \K[0-9]+' | head -1)
            if [ -n \"\$handle\" ]; then
                nft delete rule inet filter output handle \"\$handle\" 2>/dev/null || true
            fi
        else
            iptables -D OUTPUT -m owner --uid-owner $uid -j DROP 2>/dev/null || true
        fi
    " 2>/dev/null
}

blocage() {
    local user="$1" ip="$2"
    ssh -i "$key" $opt "root@$ip" "
        [ -f /home/$user/.bashrc ] && cp /home/$user/.bashrc /home/$user/.bashrc.bak.\$(date +%Y%m%d_%H%M%S)
    " 2>/dev/null || true
    if [ ! -s "$CMD_BLACKLIST_LOCALE" ]; then
        log "AVERTISSEMENT" "cmd_blacklist vide"
        return
    fi
    local alias_block=""
    alias_block+="# ContrAll-debut\n"
    alias_block+="message() {\n"
    alias_block+="    echo ''\n"
    alias_block+="    echo '[ContrAll] Commande interdite !'\n"
    alias_block+="    echo 'Une infraction a été enregistrée.'\n"
    alias_block+="    echo ''\n"
    alias_block+="    echo \"$ip|$user|CMD:\$0|\$(date '+%F %T')\" >> /tmp/contrall_alertes_${user}.txt 2>/dev/null\n"
    alias_block+="    return 1\n"
    alias_block+="}\n"
    while IFS= read -r cmd; do
        [ -z "$cmd" ] && continue
        alias_block+="alias $cmd='message'\n"
    done < "$CMD_BLACKLIST_LOCALE"
    alias_block+="# ContrAll-fin\n"
    ssh -i "$key" $opt "root@$ip" "
        sed -i '/# ContrAll-debut/,/# ContrAll-fin/d' /home/$user/.bashrc 2>/dev/null || true
    " 2>/dev/null
    printf "%b" "$alias_block" | ssh -i "$key" $opt "root@$ip" "cat >> /home/$user/.bashrc"
    log "INFO" "Alias de blocage injectés sur $user@$ip"
}

nettoyer_alias() {
    local user="$1" ip="$2"
    ssh -i "$key" $opt "root@$ip" "
        sed -i '/# ContrAll-debut/,/# ContrAll-fin/d' /home/$user/.bashrc 2>/dev/null || true
    " 2>/dev/null
    log "INFO" "Alias nettoyés pour $user@$ip"
}

envoyer_configuration() {
    local ok=0 echec=0
    dialog --infobox "Envoi de la configuration vers les clients..." 5 50
    sleep 2
    while IFS=":" read -r user ip; do
        [ -z "$user" ] && continue
        if ssh -i "$key" $opt "root@$ip" "mkdir -p /home/$user" >/dev/null 2>&1; then
            if scp -i "$key" $opt "$BLACKLIST_LOCALE" "$user@$ip:/home/$user/blacklist.txt" >/dev/null 2>&1 && \
               scp -i "$key" $opt "$CMD_BLACKLIST_LOCALE" "$user@$ip:/home/$user/cmd_blacklist.txt" >/dev/null 2>&1 && \
               scp -i "$key" $opt "$TERMINAL_AUTORISE_LOCALE" "$user@$ip:/home/$user/terminal_autorise.txt" >/dev/null 2>&1; then
                log "INFO" "Configuration envoyée à $user@$ip"
                blocage "$user" "$ip"
                ((ok++))
            else
                log_error "ERREUR" "SCP échoué pour $user@$ip"
                ((echec++))
            fi
        else
            log_error "ERREUR" "Impossible de créer /home/$user sur $user@$ip"
            ((echec++))
        fi
    done < "$LISTE"
    dialog --msgbox "Configuration terminée.\nRéussites : $ok \nÉchecs    : $echec" 10 45
}

preparation() {
    > "$LISTE"
    if ! command -v sshpass >/dev/null 2>&1; then
        dialog --msgbox "sshpass n'est pas installé." 7 45
        exit 1
    fi
    [ ! -f "$LOG" ] && touch "$LOG"
    if [ ! -f "$key" ]; then
        ssh-keygen -t ed25519 -N "" -f "$key" >/dev/null
    fi
    ip_master=$(hostname -I | awk '{print $2}')
    if [ -z "$ip_master" ]; then
        dialog --title "Erreur" --msgbox "Impossible de déterminer l'adresse IP locale." 7 55
        exit 1
    fi
    prefixe_ip=$(echo "$ip_master" | cut -d'.' -f1-3)
    tmpfile=$(mktemp)
    (
        for ((i=1; i<=254; i++)); do
            ip="$prefixe_ip.$i"
            [[ "$ip" == "$ip_master" ]] && continue
            (
                if nc -z -w 3 "$ip" 22 >/dev/null 2>&1; then
                    if command -v host >/dev/null 2>&1; then
                        hostname_full=$(host "$ip" 2>/dev/null | awk '/pointer/ {print $NF}' | sed 's/\.$//')
                    else
                        hostname_full=""
                    fi
                    user=$(echo "$hostname_full" | cut -d'-' -f1)
                    if [ -n "$user" ] && ! utilisateur_valide "$user"; then
                        user=""
                    fi
                    (
                        flock 200
                        echo "$user:$ip" >> "$tmpfile"
                    ) 200>"$tmpfile.lock"
                fi
            ) &
            echo $((i*100/254))
            x=$((x+1))
            if [ "$x" -ge "$MAX" ]; then
                wait
                x=0
            fi
        done
        wait
    ) | dialog --title "ContrAll" --gauge "Scan du réseau en cours..." 8 60 0

    local ok=0 echec=0
    while IFS=":" read -r user ip <&4; do
        [ -z "$ip" ] && continue
        if [ -z "$user" ]; then
            user=$(dialog --inputbox "Nom d'utilisateur SSH pour $ip :" 8 50 3>&1 1>&2 2>&3)
        fi
        [ -z "$user" ] && { log "AVERTISSEMENT" "Utilisateur non fourni pour $ip"; continue; }
        if ! utilisateur_valide "$user"; then
            log_error "ERREUR" "Nom d'utilisateur invalide pour $ip ('$user')"
            dialog --msgbox "Nom d'utilisateur invalide pour $ip.\nCaractères autorisés : lettres, chiffres, '.', '_', '-'." 8 55
            continue
        fi
        dialog --yesno "Donner la clé SSH à\n$user@$ip ?" 8 45
        if [ $? -eq 0 ]; then
            mdp=$(dialog --insecure --passwordbox "Mot de passe de $user :" 8 50 3>&1 1>&2 2>&3)
            tentative=1; succes=0
            while [ $tentative -le 3 ]; do
                if [ $tentative -gt 1 ]; then
                    mdp=$(dialog --insecure --passwordbox "Mot de passe incorrect.\nTentative $tentative/3 pour $user :" 10 50 3>&1 1>&2 2>&3)
                    [ -z "$mdp" ] && break
                fi
                if SSHPASS="$mdp" sshpass -e ssh-copy-id -o StrictHostKeyChecking=no -i "$cle" "$user@$ip" >/dev/null 2>&1; then
                    succes=1; break
                fi
                ((tentative++))
            done
            if [ "$succes" -eq 1 ]; then
                echo "$user:$ip" >> "$LISTE"
                ((ok++))
                log "INFO" "Clé envoyée à $user@$ip"
                tmp_pass_sudo=$(mktemp)
                chmod 600 "$tmp_pass_sudo"
                echo "$mdp" > "$tmp_pass_sudo"
                ssh -i "$key" $opt "$user@$ip" "
                    [ -f /etc/sudoers.d/contrall ] && sudo -S cp /etc/sudoers.d/contrall /etc/sudoers.d/contrall.bak.\$(date +%Y%m%d_%H%M%S)
                " < "$tmp_pass_sudo" 2>/dev/null || true
                ssh -i "$key" $opt "$user@$ip" \
                    "sudo -S bash -c '
                        p_pkill=\$(command -v pkill); p_passwd=\$(command -v passwd)
                        p_usermod=\$(command -v usermod); p_iptables=\$(command -v iptables)
                        printf \"%s ALL=(ALL) NOPASSWD: \$p_iptables,\$p_passwd,\$p_usermod,\$p_pkill\n\" \"$user\" > /etc/sudoers.d/contrall &&
                        chmod 440 /etc/sudoers.d/contrall
                    '" < "$tmp_pass_sudo"
                shred -u "$tmp_pass_sudo" 2>/dev/null || rm -f "$tmp_pass_sudo"

                tmp_pass=$(mktemp)
                chmod 600 "$tmp_pass"
                { echo "$mdp"; cat "$cle"; } > "$tmp_pass"
                ssh -i "$key" $opt "root@$ip" "
                    [ -f /etc/ssh/sshd_config ] && cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak.\$(date +%Y%m%d_%H%M%S)
                " 2>/dev/null || true
                ssh -i "$key" $opt "$user@$ip" \
                    "sudo -S bash -c \
                    'mkdir -p /root/.ssh && chmod 700 /root/.ssh && touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys && cat >> /root/.ssh/authorized_keys && sort -u -o /root/.ssh/authorized_keys /root/.ssh/authorized_keys && if grep -q \"^PermitRootLogin\" /etc/ssh/sshd_config; then sed -i \"s/.*PermitRootLogin.*/PermitRootLogin prohibit-password/\" /etc/ssh/sshd_config; else echo \"PermitRootLogin prohibit-password\" >> /etc/ssh/sshd_config; fi; systemctl reload ssh'" < "$tmp_pass"
                shred -u "$tmp_pass" 2>/dev/null || rm -f "$tmp_pass"
                log "INFO" "Clé root configurée sur $user@$ip (clé ContrAll uniquement)"
                ssh -i "$key" $opt "$user@$ip" "[ -f /home/$user/.bashrc ] || touch /home/$user/.bashrc"
                unset mdp
            else
                ((echec++))
                log_error "ERREUR" "Échec de connexion à $user@$ip après 3 tentatives"
                dialog --msgbox "Échec pour $user@$ip après 3 tentatives." 7 50
            fi
        else
            log "ALERTE" "Envoi de clé refusé pour $user@$ip"
        fi
    done 4< "$tmpfile"
    rm -f "$tmpfile" "$tmpfile.lock"
    dialog --msgbox "Préparation terminée.\nMachines configurées : $ok\nÉchecs               : $echec" 10 45
}

surveiller_applications() {
    local user="$1" ip="$2"
    local blacklist="/home/$user/blacklist.txt"
    local infractions_locales=0
    local cache="$HOME/.apps_${user}_${ip}"
    touch "$cache"
    local apps_trouvees
    apps_trouvees=$(ssh -i "$key" $opt "$user@$ip" "
        [ -f $blacklist ] || exit 0
        while IFS= read -r app; do
            [ -z \"\$app\" ] && continue
            if pgrep -u "$user" -f \"(^|/)\$app(\$| )\" >/dev/null 2>&1; then
                pkill -u "$user" -f \"(^|/)\$app(\$| )\" 2>/dev/null || true
                echo \"\$app\"
            fi
        done < $blacklist
    " 2>/dev/null)
    while IFS= read -r app; do
        [ -z "$app" ] && continue
        if ! grep -qx "$app" "$cache"; then
            echo "$app" >> "$cache"
            infractions_locales=$((infractions_locales + 1))
            log "ALERTE" "APP INTERDITE: $user@$ip a lancé $app"
            log_infraction_session "$user" "$ip" "APP" "$app"
            echo "$ip|$user|APP:$app|$(date '+%F %T')" >> "$FICHIER_ALERTES"
        fi
    done <<< "$apps_trouvees"
    if [ -s "$cache" ]; then
        while IFS= read -r app_cache; do
            if ! echo "$apps_trouvees" | grep -qx "$app_cache"; then
                sed -i "/^$app_cache$/d" "$cache"
            fi
        done < "$cache"
    fi
    echo "$infractions_locales"
}

surveiller_terminaux() {
    local user="$1" ip="$2"
    local terminal_file="/home/$user/terminal_autorise.txt"
    local infractions_locales=0
    local cache_term="$HOME/.term_${user}_${ip}"
    touch "$cache_term"
    local termes_interdits
    termes_interdits=$(ssh -i "$key" $opt "root@$ip" "
        [ -f $terminal_file ] || exit 0
        terminal_ok=\$(cat $terminal_file | tr -d '\\r\\n')
        for term in gnome-terminal xterm konsole xfce4-terminal lxterminal tilix terminator; do
            if [ \"\$term\" != \"\$terminal_ok\" ]; then
                if pgrep -u "$user" -f \"(^|/)\$term(\$| )\" >/dev/null 2>&1; then
                    pkill -u "$user" -f \"(^|/)\$term(\$| )\" 2>/dev/null || true
                    echo \"\$term\"
                fi
            fi
        done
    " 2>/dev/null)
    while IFS= read -r term; do
        [ -z "$term" ] && continue
        if ! grep -qx "$term" "$cache_term"; then
            echo "$term" >> "$cache_term"
            infractions_locales=$((infractions_locales + 1))
            log "ALERTE" "TERMINAL INTERDIT: $user@$ip utilise $term"
            log_infraction_session "$user" "$ip" "TERM" "$term"
            echo "$ip|$user|TERM:$term|$(date '+%F %T')" >> "$FICHIER_ALERTES"
        fi
    done <<< "$termes_interdits"
    if [ -s "$cache_term" ]; then
        while IFS= read -r term_cache; do
            if ! echo "$termes_interdits" | grep -qx "$term_cache"; then
                sed -i "/^$term_cache$/d" "$cache_term"
            fi
        done < "$cache_term"
    fi
    echo "$infractions_locales"
}

# Surveillance des commandes via l'historique bash (sans auditd)
surveiller_commandes() {
    local user="$1" ip="$2"
    local infractions_locales=0
    local cache_cmd="$HOME/.last_cmd_${user}_${ip}"
    local last_line=0
    [ -f "$cache_cmd" ] && last_line=$(cat "$cache_cmd" | tr -d '[:space:]')
    [[ ! "$last_line" =~ ^[0-9]+$ ]] && last_line=0

    local nouvelles
    nouvelles=$(ssh -i "$key" $opt "$user@$ip" "
        history_file=\"/home/$user/.bash_history\"
        [ -f \"\$history_file\" ] || exit 0
        total=\$(wc -l < \"\$history_file\" 2>/dev/null || echo 0)
        if [ \"\$total\" -gt $last_line ]; then
            tail -n +$((last_line + 1)) \"\$history_file\"
        fi
    " 2>/dev/null)

    local total_remote=$(ssh -i "$key" $opt "$user@$ip" "wc -l < /home/$user/.bash_history 2>/dev/null || echo 0" 2>/dev/null)
    [[ "$total_remote" =~ ^[0-9]+$ ]] && echo "$total_remote" > "$cache_cmd"

    while IFS= read -r cmd; do
        [ -z "$cmd" ] && continue
        cmd_clean=$(echo "$cmd" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        while IFS= read -r interdite; do
            [ -z "$interdite" ] && continue
            if [[ "$cmd_clean" =~ (^|[[:space:]])"$interdite"($|[[:space:]]) ]]; then
                infractions_locales=$((infractions_locales + 1))
                log "ALERTE" "COMMANDE INTERDITE (historique): $user@$ip a tapé: $cmd_clean"
                log_infraction_session "$user" "$ip" "CMD" "$cmd_clean"
                echo "$ip|$user|CMD:$cmd_clean|$(date '+%F %T')" >> "$FICHIER_ALERTES"
                break
            fi
        done < "$CMD_BLACKLIST_LOCALE"
    done <<< "$nouvelles"

    echo "$infractions_locales"
}

mettre_a_jour_restriction() {
    local user="$1" ip="$2" nouvelles_infractions="$3"
    (
        flock 200
        if grep -q "^$user:$ip:" "$RESTRICTION_FILE"; then
            ancien=$(grep "^$user:$ip:" "$RESTRICTION_FILE" | cut -d':' -f3 | tr -d '[:space:]\r')
            nouveau=$((ancien + nouvelles_infractions))
            sed -i "s|^$user:$ip:.*|$user:$ip:$nouveau|" "$RESTRICTION_FILE"
        else
            echo "$user:$ip:$nouvelles_infractions" >> "$RESTRICTION_FILE"
        fi
    ) 200>"$RESTRICTION_FILE.lock"
}

tableau() {
    while true; do
        clear
        echo -e "${violet}================================================================${neutre}"
        echo -e "${gras}${cyan}            TABLEAU DES UTILISATEURS SUSPENDUS ${neutre}"
        echo -e "${violet}================================================================${neutre}"
        echo -e "${gras}${blanc}   $(date '+%H:%M:%S')${neutre}"
        echo -e "${violet}----------------------------------------------------------------${neutre}"
        printf "${gras}${cyan}%-15s | %-15s | %-10s | %-10s | %-10s${neutre}\n" "USER" "IP" "DÉBUT" "FIN" "RESTANT"
        echo -e "${violet}----------------------------------------------------------------${neutre}"
        if [ -s "$suspendus" ]; then
            while IFS=":" read -r u i deb fni rest; do
                printf "${gras}${rouge}%-15s${neutre} | ${gras}${rouge}%-15s${neutre} | ${gras}%-10s${neutre} | ${gras}%-10s${neutre} | ${gras}${jaune}%-10s${neutre}\n" "$u" "$i" "$deb" "$fni" "$rest"
            done < "$suspendus"
        else
            echo -e "          ${gras}${vert}Aucune suspension active${neutre}"
        fi
        echo -e "${violet}================================================================${neutre}"
        sleep 1
    done
}

suspendre() {
    local user="$1" ip="$2" uid="$3"
    local debut fin
    if [ -z "$user" ] || [ -z "$ip" ] || [ -z "$uid" ]; then
        log_error "ERREUR" "Paramètres manquants"
        return 1
    fi
    notifier_client "$user" "$ip" "ContrAll" "Activite suspecte detectee. SUSPENSION IMMEDIATE !"
    if ssh -i "$key" $opt "root@$ip" "
        wall 'ContrAll : Activite suspecte. SUSPENSION IMMEDIATE !' 2>/dev/null || true
        sleep 3
        passwd -l '$user' 2>/dev/null || exit 1
        usermod --expiredate 1 '$user' 2>/dev/null || exit 1
        printf '%s\n' '$user' >> /etc/cron.deny
        printf '%s\n' '$user' >> /etc/at.deny
        session_gui=\$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u='$user' '\$3==u {print \$1; exit}')
        if [ -n \"\$session_gui\" ]; then
            systemctl freeze \"session-\$session_gui.scope\" 2>/dev/null || true
        fi
        if systemctl --help 2>&1 | grep -q freeze; then
            systemctl freeze \"user-$uid.slice\" 2>/dev/null || true
        else
            pkill -STOP -u '$user' 2>/dev/null || true
        fi
        pkill -STOP -u '$user' 2>/dev/null || true
    " >/dev/null 2>/dev/null; then
        block_network "$ip" "$uid"
        # Vider les alertes alias en cours pour éviter qu'elles ne soient lues après la levée
        ssh -i "$key" $opt "root@$ip" "rm -f /tmp/contrall_alertes_${user}.txt" 2>/dev/null
        log "ALERTE" "SUSPENDU $user@$ip"
        log_suspension_session "$user" "$ip"
        debut=$(date +'%H:%M:%S')
        fin=$(date -d "+$duree minutes" +'%H:%M:%S')
        (
            flock 200
            sed -i "s/$user:$ip:.*/$user:$ip:$debut:$fin:${duree}m00s/" "$suspendus"
        ) 200>"$suspendus.lock"
        echo "$debut:$fin"
        return 0
    else
        log_error "ERREUR" "Échec de la suspension"
        return 1
    fi
}

countdown() {
    local user="$1" ip="$2" debut="$3" fin="$4"
    local secondes=$((duree * 60))
    while ((secondes > 0)); do
        if ! grep -q "^$user:$ip:" "$suspendus" 2>/dev/null; then
            return 0
        fi
        local min_restant=$((secondes / 60))
        local sec_restant=$((secondes % 60))
        (
            flock 200
            sed -i "s|^$user:$ip:.*|$user:$ip:$debut:$fin:${min_restant}m${sec_restant}s|" "$suspendus"
        ) 200>"$suspendus.lock"
        sleep 5
        secondes=$((secondes > 5 ? secondes - 5 : 0))
    done
}

retour() {
    local ip="$1" user="$2"
    log "INFO" "Tentative de retour graphique pour $user@$ip"
    ssh -i "$key" $opt "root@$ip" "
        uid=\$(id -u $user 2>/dev/null)
        [ -n \"\$uid\" ] && {
            loginctl unlock-session 2>/dev/null || true
            systemctl thaw \"user@\$uid.service\" 2>/dev/null || true
            systemctl thaw user-\$uid.slice 2>/dev/null || true
            pkill -SIGCONT -u $user 2>/dev/null || true
        }
        systemctl list-units --type=service --state=running 2>/dev/null | grep -qE 'gdm|lightdm|sddm|display-manager' || {
            systemctl restart display-manager 2>/dev/null || true
        }
        wall 'Accès graphique rétabli par ContrAll' 2>/dev/null || true
    " 2>/dev/null || true
    log "INFO" "Retour graphique traité pour $user@$ip"
}

lever_suspension() {
    local user="$1" ip="$2" uid="$3" type="${4:-auto}"
    ssh -i "$key" $opt "root@$ip" "
        passwd -u '$user' 2>/dev/null
        usermod --expiredate '' '$user' 2>/dev/null
        sed -i '/^$user$/d' /etc/cron.deny 2>/dev/null
        sed -i '/^$user$/d' /etc/at.deny 2>/dev/null
        s=\$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u='$user' '\$3==u {print \$1; exit}')
        [ -n \"\$s\" ] && systemctl thaw \"session-\${s}.scope\" 2>/dev/null || true
        systemctl thaw user-$uid.slice 2>/dev/null || true
        pkill -CONT -u '$user' 2>/dev/null || true
    " >/dev/null 2>&1 || log_error "ERREUR" "Échec de la levée pour $user@$ip"

    unblock_network "$ip" "$uid"
    # Supprimer les alertes résiduelles pour éviter les réinjections
    ssh -i "$key" $opt "root@$ip" "rm -f /tmp/contrall_alertes_${user}.txt" 2>/dev/null

    (
        flock 200
        sed -i "/^$user:$ip:/d" "$suspendus"
    ) 200>"$suspendus.lock"
    rm -f "$HOME/.apps_${user}_${ip}" "$HOME/.term_${user}_${ip}" "$HOME/.last_cmd_${user}_${ip}"
    ssh -i "$key" $opt "$user@$ip" "> ~/.bash_history" 2>/dev/null || true
    retour "$ip" "$user"
    log "INFO" "SUSPENSION LEVEE $user:$ip"
    log_levee_session "$user" "$ip" "$type"
}

traiter_utilisateur() {
    local user="$1" ip="$2"
    (
        flock -n 200 || exit 1
        if grep -q "^$user:$ip:" "$suspendus"; then
            exit 2
        fi
        echo "$user:$ip:EN_COURS:EN_COURS:EN_COURS" >> "$suspendus"
    ) 200>"$suspendus.lock"
    case $? in 1|2) return ;; esac
    (
        uid=$(ssh -i "$key" $opt "root@$ip" "id -u $user" 2>/dev/null)
        if [ -z "$uid" ]; then
            log "AVERTISSEMENT" "Impossible d'obtenir l'uid pour $user@$ip"
            sed -i "/^$user:$ip:EN_COURS/d" "$suspendus" 2>/dev/null
            exit 1
        fi
        periode=$(suspendre "$user" "$ip" "$uid")
        if [ $? -eq 0 ]; then
            debut="${periode%%:*}"
            fin="${periode##*:}"
            marquer_cooldown "$user" "$ip"
            if grep -q "^$user:$ip:" "$RESTRICTION_FILE"; then
                sed -i "s|^$user:$ip:.*|$user:$ip:0|" "$RESTRICTION_FILE"
            fi
            log "INFO" "Compteur remis à 0 pour $user:$ip"
            countdown "$user" "$ip" "$debut" "$fin"
            lever_suspension "$user" "$ip" "$uid" "auto"
        else
            sed -i "/^$user:$ip:EN_COURS/d" "$suspendus"
            log_error "ERREUR" "Échec suspension $user@$ip — EN_COURS retiré"
        fi
    ) &
}

surveiller_clients() {
    while IFS=: read -r user ip; do
        [ -z "$user" ] && continue
        verifier_ssh "$ip" "$user" || continue
        grep -q "^$user:$ip:" "$suspendus" 2>/dev/null && continue

        # Récupérer les infractions alias
        if ssh -i "$key" $opt "root@$ip" "[ -f /tmp/contrall_alertes_${user}.txt ]" 2>/dev/null; then
            local alias_infractions
            alias_infractions=$(ssh -i "$key" $opt "root@$ip" "cat /tmp/contrall_alertes_${user}.txt" 2>/dev/null)
            if [ -n "$alias_infractions" ]; then
                local nb_alias_infra=$(echo "$alias_infractions" | wc -l)
                echo "$alias_infractions" >> "$FICHIER_ALERTES"
                mettre_a_jour_restriction "$user" "$ip" "$nb_alias_infra"
                notifier_client "$user" "$ip" "INFRACTION DÉTECTÉE" \
                    "Vous avez tenté d'utiliser une commande interdite. Infraction enregistrée."
                log "ALERTE" "INFRACTION (alias) pour $user@$ip (+$nb_alias_infra)"
                ssh -i "$key" $opt "root@$ip" "> /tmp/contrall_alertes_${user}.txt" 2>/dev/null
            fi
        fi

        local infractions=0
        apps_infra=$(surveiller_applications "$user" "$ip" 2>/dev/null || echo 0)
        [[ "$apps_infra" =~ ^[0-9]+$ ]] || apps_infra=0
        infractions=$((infractions + apps_infra))

        term_infra=$(surveiller_terminaux "$user" "$ip" 2>/dev/null || echo 0)
        [[ "$term_infra" =~ ^[0-9]+$ ]] || term_infra=0
        infractions=$((infractions + term_infra))

        cmd_infra=$(surveiller_commandes "$user" "$ip" 2>/dev/null || echo 0)
        [[ "$cmd_infra" =~ ^[0-9]+$ ]] || cmd_infra=0
        infractions=$((infractions + cmd_infra))

        if [ "$infractions" -gt 0 ]; then
            mettre_a_jour_restriction "$user" "$ip" "$infractions"
            notifier_client "$user" "$ip" "INFRACTION DÉTECTÉE" \
                "Vous avez violé les règles du système ContrAll. Continuez et vous serez suspendu !"
            log "ALERTE" "INFRACTION pour $user@$ip (+$infractions)"
        fi
    done < "$LISTE"
}

verification() {
    local fin=$(( $(date +%s) + temps * 60 ))
    while (( $(date +%s) < fin )); do
        surveiller_clients
        tmp_entries=$(mktemp)
        (
            flock 200
            while IFS=: read -r user ip nb; do
                [ -z "$user" ] && continue
                nb=$(echo "$nb" | tr -d '[:space:]')
                (( nb >= seuil )) && echo "$user:$ip" >> "$tmp_entries"
            done < "$RESTRICTION_FILE"
        ) 200>"$RESTRICTION_FILE.lock"
        while IFS=: read -r user ip; do
            [ -z "$user" ] && continue
            verifier_cooldown "$user" "$ip" && continue
            traiter_utilisateur "$user" "$ip"
        done < "$tmp_entries"
        rm -f "$tmp_entries"
        sleep 2
    done
}

afficher_bilan_formate() {
    echo "--- RAPPORT DE SESSION ---"
    echo "Total machines : $(wc -l < "$LISTE" 2>/dev/null || echo 0)"
    echo "Alertes totales : $(wc -l < "$FICHIER_ALERTES" 2>/dev/null || echo 0)"
    echo "Suspendus : $( [ -s "$suspendus" ] && wc -l < "$suspendus" 2>/dev/null || echo 0 )"
    echo "--------------------------"
    echo "Logs : $(tail -n 1 "$LOG" 2>/dev/null || echo 'aucun log')"
}

grace() {
    if [ ! -s "$suspendus" ]; then
        dialog --msgbox "Aucune suspension active en cours" 7 40
        return
    fi
    args=()
    while IFS=":" read -r u i deb fin rest; do
        [ "$deb" = "EN_COURS" ] && continue
        args+=("$u@$i" "Depuis $deb - Reste: $rest")
    done < "$suspendus"
    if [ "${#args[@]}" -eq 0 ]; then
        dialog --msgbox "Suspension en cours d'initialisation." 7 55
        return
    fi
    choix=$(dialog --clear --title "Lever une suspension" --menu "Choisissez un utilisateur à libérer :" 15 60 5 "${args[@]}" 3>&1 1>&2 2>&3)
    [ -z "$choix" ] && return
    user=$(echo "$choix" | cut -d'@' -f1)
    ip=$(echo "$choix" | cut -d'@' -f2)
    dialog --yesno "Libérer $user@$ip maintenant ?" 7 40 || return
    uid=$(ssh -i "$key" $opt "root@$ip" "id -u $user" 2>/dev/null)
    if [ -n "$uid" ]; then
        lever_suspension "$user" "$ip" "$uid" "manuelle"
        dialog --msgbox "$user@$ip a été libéré." 7 40
        log "INFO" "Levée manuelle de la suspension de $user@$ip réussie"
    else
        dialog --msgbox "Impossible de contacter $ip." 7 40
        log_error "ERREUR" "Levée manuelle échouée (uid introuvable)"
    fi
}

generer_rapport() {
    {
        echo "================================================"
        echo "       RAPPORT DE SESSION CONTRALL"
        echo "================================================"
        echo "Date début  : $date_debut_session"
        echo "Date fin    : $(date '+%Y-%m-%d %H:%M:%S')"
        echo "Durée       : $temps minutes"
        echo "Seuil       : $seuil infractions"
        echo "Suspension  : $duree minutes"
        echo "------------------------------------------------"
        echo "SLAVES SURVEILLÉS :"
        while IFS=":" read -r user ip; do
            echo "  → $user@$ip"
        done < "$LISTE"
        echo "------------------------------------------------"
        echo "INFRACTIONS DÉTECTÉES :"
        grep -E "\[ALERTE\]|INFRACTION \(alias\)" "$LOG" | sed 's/^/  /' || echo "  Aucune"
        echo "------------------------------------------------"
        echo "SUSPENSIONS :"
        grep "SUSPENDU\|SUSPENSION LEVEE" "$LOG" | sed 's/^/  /' || echo "  Aucune"
        echo "================================================"
    } > "$rapport"
    dialog --title "Rapport généré" --msgbox "Rapport sauvegardé dans :\n$rapport" 7 55
    log "INFO" "Rapport de session généré : $rapport"
}

menu_gestion() {
    while true; do
        if [ -z "${verification_pid:-}" ] || ! kill -0 "$verification_pid" 2>/dev/null; then
            dialog --title "Info" --msgbox "La durée de surveillance est écoulée." 7 40
            return 1
        fi
        choix=$(dialog --clear --title "ContrAll - Pilotage" \
            --menu "Sélectionnez une vue (Processus actif: $verification_pid) :" 17 55 6 \
            "1" "Tableau des suspensions (Temps réel)" \
            "2" "Consulter les derniers Logs" \
            "3" "Consulter les erreurs" \
            "4" "Afficher le bilan global" \
            "5" "Lever une suspension manuellement" \
            "6" "Quitter ContrAll" 3>&1 1>&2 2>&3)
        case $choix in
            1)
                clear; tput reset 2>/dev/null || true
                tableau &
                tableau_pid=$!
                read -r -p "Appuyez sur Entrée pour revenir au menu..." _ </dev/tty
                kill $tableau_pid 2>/dev/null; wait $tableau_pid 2>/dev/null
                ;;
            2) [ -f "$LOG" ] && dialog --title "Historique" --textbox "$LOG" 15 70 || dialog --msgbox "Log introuvable" 5 30 ;;
            3) if [ -f "$ERROR_LOG" ] && [ -s "$ERROR_LOG" ]; then dialog --title "Erreurs" --textbox "$ERROR_LOG" 20 75; else dialog --msgbox "Aucune erreur" 7 40; fi ;;
            4) bilan_texte=$(afficher_bilan_formate); dialog --title "Bilan" --msgbox "$bilan_texte" 15 50 ;;
            5) grace ;;
            6) return 0 ;;
            *) return 0 ;;
        esac
    done
}

